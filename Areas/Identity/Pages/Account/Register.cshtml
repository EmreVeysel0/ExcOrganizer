@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">

        <div class="card shadow-sm border-0" style="border-radius:12px; overflow:hidden;">

            <div class="card-header text-white py-3 text-center"
                 style="background:linear-gradient(135deg,#1a73e8,#0d47a1);">
                <i class="bi bi-person-plus fs-3 d-block mb-1"></i>
                <h5 class="mb-0 fw-bold">Създай акаунт</h5>
            </div>

            <div class="card-body p-4">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label fw-semibold small">
                            <i class="bi bi-person me-1 text-primary"></i> Потребителско име
                        </label>
                        <input asp-for="Input.Username" class="form-control"
                               autocomplete="username"
                               placeholder="напр. ivan123" />
                        <span asp-validation-for="Input.Username" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">

                        <label asp-for="Input.Email" class="form-label fw-semibold small">
                            <i class="bi bi-envelope me-1 text-primary"></i> Имейл
                        </label>
                        <input asp-for="Input.Email" class="form-control"
                               autocomplete="username"
                               placeholder="example@mail.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold small">
                            <i class="bi bi-lock me-1 text-primary"></i> Парола
                        </label>
                        <input asp-for="Input.Password" class="form-control"
                               autocomplete="new-password"
                               placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold small">
                            <i class="bi bi-lock-fill me-1 text-primary"></i> Потвърди паролата
                        </label>
                        <input asp-for="Input.ConfirmPassword" class="form-control"
                               autocomplete="new-password"
                               placeholder="••••••••" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn w-100 py-2 fw-bold text-white"
                            style="background:linear-gradient(135deg,#1a73e8,#0d47a1); border:none; border-radius:8px;">
                        <i class="bi bi-person-plus me-1"></i> Регистрирай се
                    </button>

                </form>

            </div>

            <div class="card-footer text-center py-3" style="background:#f8fafc;">
                <span class="text-muted small">Вече имаш акаунт?</span>
                <a href="/Identity/Account/Login" class="fw-bold ms-1" style="color:#1a73e8;">
                    Влез
                </a>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}