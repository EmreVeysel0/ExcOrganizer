@using Microsoft.AspNetCore.Authentication
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExcOrganizer</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            
            height: 100%;
            background-color: #f0f4f8;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient(135deg, #1a73e8, #0d47a1) !important;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }

        .navbar-brand {
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: 1px;
        }

            .navbar-brand i {
                margin-right: 6px;
            }

        .nav-link {
            font-weight: 500;
        }

        .navbar .btn-outline-light {
            border-radius: 20px;
            padding: 4px 16px;
        }

        .main-container {
            max-width: 1100px;
            margin: 30px auto;
            padding: 0 15px;
            flex: 1;
            width: 100%;
        }

        footer {
            background-color: #1a73e8;
            color: white;
            text-align: center;
            padding: 14px;
            margin-top: auto;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-globe2"></i> ExcOrganizer
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Administrator"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Trips/MyTrips">
                                <i class="bi bi-person-check me-1"></i> Моите екскурзии
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="/Trips">
                            <i class="bi bi-map me-1"></i> Екскурзии
                        </a>
                    </li>
                </ul>

                <div class="d-flex gap-2 align-items-center">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="text-white">
                            <i class="bi bi-person-circle"></i> @User.Identity.Name
                        </span>
                        <a class="btn btn-outline-light btn-sm" href="#"
                           onclick="document.getElementById('logoutModal').style.display='flex'; return false;">
                            <i class="bi bi-box-arrow-right me-1"></i> Изход
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm" href="/Identity/Account/Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Вход
                        </a>
                        <a class="btn btn-light btn-sm text-primary fw-bold" href="/Identity/Account/Register">
                            <i class="bi bi-person-plus me-1"></i> Регистрация
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="main-container">
        @RenderBody()
    </div>

    <!-- Logout Modal -->
    <div id="logoutModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
     background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
        <div style="background:white; border-radius:12px; padding:2rem; max-width:380px; width:90%; text-align:center; box-shadow:0 10px 40px rgba(0,0,0,0.2);">

            <div style="width:60px; height:60px; background:#fef2f2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem;">
                <i class="bi bi-box-arrow-right" style="font-size:1.5rem; color:#dc3545;"></i>
            </div>

            <h5 class="fw-bold mb-2">Изход от системата</h5>
            <p class="text-muted mb-4">Сигурен ли си, че искаш да излезеш?</p>

            <div class="d-flex gap-2 justify-content-center">
                <button class="btn btn-outline-secondary px-4"
                        onclick="document.getElementById('logoutModal').style.display='none'">
                    Откажи
                </button>
                <form action="/Identity/Account/Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-box-arrow-right me-1"></i> Да, излез
                    </button>
                </form>
            </div>

        </div>
    </div>

    <footer>
        &copy; @DateTime.Now.Year ExcOrganizer &mdash; Всички права запазени
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>