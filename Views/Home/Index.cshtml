@model IEnumerable<ExcOrganizer.Data.Models.Trip>
@{
    ViewData["Title"] = "Начало";
    Layout = "_Layout";
}

<div class="hero-section mb-5">
    <div class="hero-content text-center py-5">
        <h1 class="hero-title">Открий света с нас</h1>
        <p class="hero-subtitle">Намери своята следваща екскурзия и резервирай място лесно и бързо</p>
        <a href="/Trips" class="btn btn-primary btn-lg px-4 me-2">
            <i class="bi bi-map me-2"></i> Виж всички екскурзии
        </a>
        @if (!User.Identity.IsAuthenticated)
        {
            <a href="/Identity/Account/Register" class="btn btn-outline-primary btn-lg px-4">
                <i class="bi bi-person-plus me-2"></i> Регистрирай се
            </a>
        }
    </div>
</div>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1" style="color:#1a73e8;">Предстоящи екскурзии</h2>
        <p class="text-muted mb-0">Разгледай най-новите ни предложения</p>
    </div>
    <a href="/Trips" class="btn btn-outline-primary">
        Всички <i class="bi bi-arrow-right ms-1"></i>
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-info-circle-fill fs-5"></i>
        <span>Все още няма добавени екскурзии.</span>
    </div>
}
else
{
    <div class="row">
        @foreach (var t in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0 trip-home-card">
                    <div class="card-header-custom">
                        <i class="bi bi-geo-alt-fill me-1"></i> @t.Destination
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@t.Title</h5>

                        <p class="text-muted small mb-1">
                            <i class="bi bi-calendar3 me-1 text-primary"></i>
                            @t.StartDate.ToString("dd.MM.yyyy") &ndash; @t.EndDate.ToString("dd.MM.yyyy")
                        </p>

                        <p class="text-muted small mb-3">
                            <i class="bi bi-people-fill me-1 text-primary"></i>
                            @t.Seats свободни места
                        </p>

                        @if (!string.IsNullOrWhiteSpace(t.Description))
                        {
                            <p class="text-muted small mb-3" style="overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">
                                @t.Description
                            </p>
                        }

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="trip-price">
                                @t.Price.ToString("0.00") <small>EUR</small>
                            </span>
                            @if (t.Seats <= 0)
                            {
                                <span class="badge bg-danger">Изчерпани</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3 px-3">
                        <a href="/Trips/Details/@t.Id" class="btn btn-primary w-100">
                            <i class="bi bi-eye me-1"></i> Детайли и резервация
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="row mt-5 mb-4 g-4">
    <div class="col-md-4">
        <div class="info-box text-center p-4">
            <div class="info-icon mb-3">
                <i class="bi bi-shield-check"></i>
            </div>
            <h5 class="fw-bold">Сигурна резервация</h5>
            <p class="text-muted small mb-0">Твоята резервация е защитена и гарантирана от нас</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="info-box text-center p-4">
            <div class="info-icon mb-3">
                <i class="bi bi-globe2"></i>
            </div>
            <h5 class="fw-bold">Множество дестинации</h5>
            <p class="text-muted small mb-0">Избери от десетки дестинации в цяла Европа и света</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="info-box text-center p-4">
            <div class="info-icon mb-3">
                <i class="bi bi-headset"></i>
            </div>
            <h5 class="fw-bold">Поддръжка 24/7</h5>
            <p class="text-muted small mb-0">Нашият екип е на разположение по всяко време</p>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background: linear-gradient(135deg, #1a73e8, #0d47a1);
        border-radius: 16px;
        color: white;
        padding: 1rem;
    }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: white;
        margin-bottom: 0.75rem;
    }

    .hero-subtitle {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.85);
        margin-bottom: 1.75rem;
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-section .btn-primary {
        background: white;
        color: #1a73e8;
        border: none;
        font-weight: 600;
    }

        .hero-section .btn-primary:hover {
            background: #f0f4f8;
            color: #0d47a1;
        }

    .hero-section .btn-outline-primary {
        border-color: white;
        color: white;
        font-weight: 600;
    }

        .hero-section .btn-outline-primary:hover {
            background: rgba(255,255,255,0.15);
            color: white;
            border-color: white;
        }

    .trip-home-card {
        border-radius: 12px !important;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .trip-home-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.12) !important;
        }

    .card-header-custom {
        background: linear-gradient(135deg, #1a73e8, #0d47a1);
        color: white;
        padding: 10px 16px;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .trip-price {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1a73e8;
    }

        .trip-price small {
            font-size: 0.72rem;
            color: #6c757d;
            font-weight: 500;
        }

    .info-box {
        background: white;
        border-radius: 12px;
        border: 1px solid #e0e7ef;
        transition: box-shadow 0.2s;
    }

        .info-box:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

    .info-icon {
        width: 56px;
        height: 56px;
        background: #e8f0fe;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 1.5rem;
        color: #1a73e8;
    }
</style>