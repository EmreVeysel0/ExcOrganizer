@{
    ViewData["Title"] = "За нас";
    Layout = "_Layout";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-8 text-center">
        <h2 class="fw-bold mb-3" style="color:#1a73e8;">
            <i class="bi bi-globe2 me-2"></i>За нас
        </h2>
        <p class="text-muted fs-5">
            ExcOrganizer е вашият надежден партньор за незабравими пътувания и екскурзии по целия свят.
        </p>
    </div>
</div>

<!-- Мисия -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:16px; overflow:hidden;">
    <div class="row g-0">
        <div class="col-md-4 d-flex align-items-center justify-content-center p-4"
             style="background:linear-gradient(135deg,#1a73e8,#0d47a1);">
            <i class="bi bi-star-fill text-white" style="font-size:4rem;"></i>
        </div>
        <div class="col-md-8">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3" style="color:#1a73e8;">Нашата мисия</h4>
                <p class="text-muted mb-0">
                    Вярваме че пътуването е най-добрият начин да опознаеш света.
                    Нашата цел е да предоставим на всеки клиент незабравимо изживяване,
                    организирано с внимание към детайла и грижа за удовлетвореността.
                    От резервацията до завръщането у дома — ние сме до теб!
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Защо ние -->
<h4 class="fw-bold mb-4 text-center" style="color:#1a73e8;">Защо да изберете нас?</h4>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-center p-4" style="border-radius:14px;">
            <div style="width:60px; height:60px; background:#e8f0fe; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem;">
                <i class="bi bi-shield-check" style="font-size:1.5rem; color:#1a73e8;"></i>
            </div>
            <h5 class="fw-bold">Сигурност</h5>
            <p class="text-muted small mb-0">
                Всички наши екскурзии са внимателно планирани и застраховани.
                Твоята безопасност е наш приоритет номер едно.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-center p-4" style="border-radius:14px;">
            <div style="width:60px; height:60px; background:#e8f0fe; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem;">
                <i class="bi bi-people-fill" style="font-size:1.5rem; color:#1a73e8;"></i>
            </div>
            <h5 class="fw-bold">Опитен екип</h5>
            <p class="text-muted small mb-0">
                Нашите екскурзоводи имат над 10 години опит и говорят
                български, английски и немски език.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-center p-4" style="border-radius:14px;">
            <div style="width:60px; height:60px; background:#e8f0fe; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem;">
                <i class="bi bi-currency-euro" style="font-size:1.5rem; color:#1a73e8;"></i>
            </div>
            <h5 class="fw-bold">Най-добри цени</h5>
            <p class="text-muted small mb-0">
                Предлагаме конкурентни цени без скрити такси.
                Плащаш само това което виждаш!
            </p>
        </div>
    </div>
</div>

<!-- Статистики -->
<div class="p-4 mb-5 text-white text-center"
     style="background:linear-gradient(135deg,#1a73e8,#0d47a1); border-radius:16px;">
    <div class="row g-4">
        <div class="col-6 col-md-3">
            <div style="font-size:2rem; font-weight:800;">500+</div>
            <div style="font-size:0.9rem; opacity:0.85;">Доволни клиенти</div>
        </div>
        <div class="col-6 col-md-3">
            <div style="font-size:2rem; font-weight:800;">50+</div>
            <div style="font-size:0.9rem; opacity:0.85;">Дестинации</div>
        </div>
        <div class="col-6 col-md-3">
            <div style="font-size:2rem; font-weight:800;">10+</div>
            <div style="font-size:0.9rem; opacity:0.85;">Години опит</div>
        </div>
        <div class="col-6 col-md-3">
            <div style="font-size:2rem; font-weight:800;">24/7</div>
            <div style="font-size:0.9rem; opacity:0.85;">Поддръжка</div>
        </div>
    </div>
</div>

<!-- Контакти -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
    <div class="card-body p-4">
        <h4 class="fw-bold mb-4" style="color:#1a73e8;">
            <i class="bi bi-envelope me-2"></i>Свържи се с нас
        </h4>
        <div class="row g-3">
            <div class="col-md-4 d-flex align-items-center gap-3">
                <div style="width:44px; height:44px; background:#e8f0fe; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                    <i class="bi bi-telephone-fill" style="color:#1a73e8;"></i>
                </div>
                <div>
                    <div class="small text-muted">Телефон</div>
                    <div class="fw-semibold">+359 88 888 8888</div>
                </div>
            </div>
            <div class="col-md-4 d-flex align-items-center gap-3">
                <div style="width:44px; height:44px; background:#e8f0fe; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                    <i class="bi bi-envelope-fill" style="color:#1a73e8;"></i>
                </div>
                <div>
                    <div class="small text-muted">Имейл</div>
                    <div class="fw-semibold">info@excorganizer.bg</div>
                </div>
            </div>
            <div class="col-md-4 d-flex align-items-center gap-3">
                <div style="width:44px; height:44px; background:#e8f0fe; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                    <i class="bi bi-geo-alt-fill" style="color:#1a73e8;"></i>
                </div>
                <div>
                    <div class="small text-muted">Адрес</div>
                    <div class="fw-semibold">София, България</div>
                </div>
            </div>
        </div>
    </div>
</div>