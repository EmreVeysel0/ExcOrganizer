@model IEnumerable<ExcOrganizer.Data.Models.Booking>
@{
    ViewData["Title"] = "Моите екскурзии";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color:#1a73e8;">
            <i class="bi bi-person-check me-2"></i>Моите екскурзии
        </h2>
        <p class="text-muted mb-0">Всички твои резервации на едно място</p>
    </div>
    <a href="/Trips" class="btn btn-outline-primary">
        <i class="bi bi-map me-1"></i> Разгледай екскурзии
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5" style="background:white; border-radius:16px; border:1px solid #e0e7ef;">
        <i class="bi bi-calendar-x" style="font-size:3rem; color:#cbd5e1; display:block; margin-bottom:1rem;"></i>
        <h5 class="fw-bold" style="color:#0d47a1;">Нямаш резервации все още</h5>
        <p class="text-muted mb-4">Разгледай наличните екскурзии и резервирай своето място!</p>
        <a href="/Trips" class="btn btn-primary px-4">
            <i class="bi bi-map me-2"></i> Виж екскурзиите
        </a>
    </div>
}
else
{
    <div class="row">
        @foreach (var b in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius:14px; overflow:hidden;">

                    <div style="background:linear-gradient(135deg,#1a73e8,#0d47a1); padding:12px 18px; display:flex; justify-content:space-between; align-items:center;">
                        <span style="color:white; font-size:0.82rem; font-weight:600; letter-spacing:0.5px;">
                            <i class="bi bi-geo-alt-fill me-1"></i> @b.Trip.Destination
                        </span>
                        <span style="background:rgba(255,255,255,0.2); color:white; border-radius:20px; padding:2px 10px; font-size:0.75rem; font-weight:600;">
                            Резервирано
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="fw-bold mb-3" style="color:#0d47a1;">@b.Trip.Title</h5>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div style="background:#f0f4f8; border-radius:10px; padding:10px; text-align:center;">
                                    <div style="font-size:0.7rem; color:#6c757d; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:3px;">Начало</div>
                                    <div style="font-weight:700; color:#0d47a1; font-size:0.95rem;">@b.Trip.StartDate.ToString("dd.MM.yyyy")</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background:#f0f4f8; border-radius:10px; padding:10px; text-align:center;">
                                    <div style="font-size:0.7rem; color:#6c757d; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:3px;">Край</div>
                                    <div style="font-weight:700; color:#0d47a1; font-size:0.95rem;">@b.Trip.EndDate.ToString("dd.MM.yyyy")</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div style="font-size:0.75rem; color:#6c757d; margin-bottom:2px;">Цена</div>
                                <div style="font-size:1.2rem; font-weight:700; color:#1a73e8;">
                                    @b.Trip.Price.ToString("0.00") <small style="font-size:0.72rem; color:#6c757d; font-weight:500;">EUR</small>
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-size:0.75rem; color:#6c757d; margin-bottom:2px;">Дата на резервация</div>
                                <div style="font-size:0.88rem; font-weight:600; color:#495057;">@b.BookingDate.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                        </div>

                        <div class="mt-auto">
                            <a href="/Trips/Details/@b.Trip.Id" class="btn btn-outline-primary w-100">
                                <i class="bi bi-eye me-1"></i> Виж детайли
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
}