@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "Моят профил";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        <!-- Профил хедър -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px; overflow:hidden;">
            <div style="background:linear-gradient(135deg,#1a73e8,#0d47a1); padding:2rem; text-align:center;">
                <div style="width:80px; height:80px; background:rgba(255,255,255,0.2); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem;">
                    <i class="bi bi-person-fill text-white" style="font-size:2.5rem;"></i>
                </div>
                <h5 class="text-white fw-bold mb-1">@Model.UserName</h5>
                <span style="background:rgba(255,255,255,0.2); color:white; border-radius:20px; padding:3px 14px; font-size:0.82rem;">
                    @(User.IsInRole("Administrator") ? "Администратор" : "Потребител")
                </span>
            </div>
        </div>

        <!-- Промяна на имейл -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
            <div class="card-header py-3 px-4" style="background:#f8fafc; border-bottom:1px solid #e0e7ef;">
                <h5 class="fw-bold mb-0" style="color:#1a73e8;">
                    <i class="bi bi-envelope me-2"></i>Промяна на имейл
                </h5>
            </div>
            <div class="card-body p-4">
                <form action="/Profile/ChangeEmail" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Текущ имейл</label>
                        <input class="form-control bg-light" value="@Model.Email" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">
                            <i class="bi bi-envelope me-1 text-primary"></i> Нов имейл
                        </label>
                        <input type="email" name="newEmail" class="form-control"
                               placeholder="нов@имейл.com" />
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy me-1"></i> Запази имейла
                    </button>
                </form>
            </div>
        </div>

        <!-- Промяна на парола -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
            <div class="card-header py-3 px-4" style="background:#f8fafc; border-bottom:1px solid #e0e7ef;">
                <h5 class="fw-bold mb-0" style="color:#1a73e8;">
                    <i class="bi bi-lock me-2"></i>Промяна на парола
                </h5>
            </div>
            <div class="card-body p-4">
                <form action="/Profile/ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">
                            <i class="bi bi-lock me-1 text-primary"></i> Текуща парола
                        </label>
                        <input type="password" name="currentPassword" class="form-control"
                               placeholder="••••••••" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">
                            <i class="bi bi-lock-fill me-1 text-primary"></i> Нова парола
                        </label>
                        <input type="password" name="newPassword" class="form-control"
                               placeholder="••••••••" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small">
                            <i class="bi bi-lock-fill me-1 text-primary"></i> Потвърди новата парола
                        </label>
                        <input type="password" name="confirmPassword" class="form-control"
                               placeholder="••••••••" />
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy me-1"></i> Промени паролата
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>